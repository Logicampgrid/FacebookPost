# ===================================================================
# CONFIGURATION FRONTEND FACEBOOKPOST - VERSION WINDOWS  
# ===================================================================
# Ce fichier sera automatiquement mis à jour par les scripts .bat
# avec l'URL ngrok générée par le backend
# ===================================================================

# === URL BACKEND (MISE À JOUR AUTOMATIQUE) ===
# Cette valeur sera automatiquement remplacée par l'URL ngrok
REACT_APP_BACKEND_URL=http://localhost:8001

# === CONFIGURATION DÉVELOPPEMENT ===
# Permet de désactiver la vérification d'hôte pour ngrok
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Désactive les erreurs ESLint qui bloquent le build
ESLINT_NO_DEV_ERRORS=true

# Configuration réseau
HOST=0.0.0.0
PORT=3000

# === CONFIGURATION FACEBOOK SDK ===
# ID de l'application Facebook (doit correspondre au backend)
REACT_APP_FACEBOOK_APP_ID=5664227323683118

# Version de l'API Facebook à utiliser
REACT_APP_FACEBOOK_API_VERSION=v18.0

# === CONFIGURATION ENVIRONNEMENT ===
# Environnement de développement
NODE_ENV=development

# Cache désactivé pour développement
GENERATE_SOURCEMAP=false

# === CONFIGURATION NGROK ===
# Ces valeurs sont mises à jour automatiquement par les scripts
REACT_APP_NGROK_ENABLED=true
REACT_APP_CURRENT_NGROK_URL=

# === CONFIGURATION UI ===
# Theme et personnalisation
REACT_APP_THEME=facebook
REACT_APP_BRAND_NAME=FacebookPost

# Fonctionnalités activées
REACT_APP_ENABLE_INSTAGRAM=true
REACT_APP_ENABLE_FACEBOOK=true
REACT_APP_ENABLE_WEBHOOK_HISTORY=true

# === CONFIGURATION DÉBOGAGE ===
# Active les logs de débogage dans la console
REACT_APP_DEBUG=false

# Active les outils de développement React
REACT_APP_DEV_TOOLS=true

# === URLS ET ENDPOINTS ===
# Endpoints API (relatifs à REACT_APP_BACKEND_URL)
REACT_APP_API_BASE=/api
REACT_APP_WEBHOOK_ENDPOINT=/api/webhook
REACT_APP_HEALTH_ENDPOINT=/api/health

# === CONFIGURATION UPLOAD ===
# Taille maximale des fichiers (en MB)
REACT_APP_MAX_FILE_SIZE=50

# Types de fichiers autorisés
REACT_APP_ALLOWED_FILE_TYPES=image/*,video/*

# === PERFORMANCE ===
# Lazy loading des composants
REACT_APP_LAZY_LOADING=true

# Compression des images
REACT_APP_IMAGE_COMPRESSION=true

# === NOTIFICATIONS ===
# Notifications navigateur
REACT_APP_ENABLE_NOTIFICATIONS=true

# Durée d'affichage des toasts (ms)
REACT_APP_TOAST_DURATION=5000
# CONFIGURATION FACEBOOK POST ENHANCED
# Copier vers .env et remplir les valeurs

# === FACEBOOK APP CONFIGURATION ===
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CLIENT_TOKEN=your_client_token

# === STORES CONFIGURATION ===
# Store Gizmobbs
FB_ACCESS_TOKEN_GIZMO=your_gizmobbs_facebook_token
IG_USER_ID_GIZMO=your_gizmobbs_instagram_user_id

# Store LogicAntiq  
FB_ACCESS_TOKEN_LOGICANTIQ=your_logicantiq_facebook_token
IG_USER_ID_LOGICANTIQ=your_logicantiq_instagram_user_id

# Store Outdoor
FB_ACCESS_TOKEN_OUTDOOR=your_outdoor_facebook_token
IG_USER_ID_OUTDOOR=your_outdoor_instagram_user_id

# === FTP CONFIGURATION ===
FTP_HOST=logicamp.org
FTP_PORT=21
FTP_USER=logi
FTP_PASSWORD=your_ftp_password

# === SERVER CONFIGURATION ===
BACKEND_PORT=8001
FRONTEND_PORT=3000
ENABLE_NGROK=detect
PUBLICATION_TEST_MODE=false

# === MONGODB CONFIGURATION ===
MONGO_URL=mongodb://localhost:27017/facebookpost
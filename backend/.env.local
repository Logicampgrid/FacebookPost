# CONFIGURATION LOCALE - FacebookPost Windows
# Copiez ce fichier vers .env pour l'utilisation locale

# === BASE DE DONNÉES LOCALE ===
MONGO_URL=mongodb://localhost:27017

# === CONFIGURATION FACEBOOK/META ===
FACEBOOK_APP_ID=5664227323683118
FACEBOOK_APP_SECRET=b359a1c87c920288385daf75aed873a3
JWT_SECRET=your-secret-key-change-in-production
FACEBOOK_GRAPH_URL=https://graph.facebook.com/v18.0

# === CONFIGURATION LOCALE (PAS DE NGROK) ===
ENABLE_NGROK=false
PUBLIC_BASE_URL=http://localhost:8001
EXTERNAL_WEBHOOK_ENABLED=false

# === TOKEN WEBHOOK (Optionnel pour usage local) ===
FACEBOOK_VERIFY_TOKEN=mon_token_secret_webhook

# === TOKENS D'ACCÈS BOUTIQUES (À CONFIGURER) ===
# Laissez vide et utilisez l'interface web pour l'authentification
FB_ACCESS_TOKEN_LOGICANTIQ=
FB_ACCESS_TOKEN_LOGICAMPOUTDOOR=
FB_ACCESS_TOKEN_BERGER=
FB_ACCESS_TOKEN_GIZMO=

# === IDS PAGES FACEBOOK (Récupérés automatiquement) ===
FB_PAGE_ID_LOGICANTIQ=
FB_PAGE_ID_LOGICAMPOUTDOOR=
FB_PAGE_ID_BERGER=
FB_PAGE_ID_GIZMO=

# === IDS COMPTES INSTAGRAM (Récupérés automatiquement) ===
IG_USER_ID_LOGICANTIQ=
IG_USER_ID_LOGICAMPOUTDOOR=
IG_USER_ID_BERGER=
IG_USER_ID_GIZMO=

# === MODE TEST (Recommandé pour débuter) ===
PUBLICATION_TEST_MODE=true

# === CONFIGURATION DRY_RUN ===
DRY_RUN=false
FORCE_FTP=false
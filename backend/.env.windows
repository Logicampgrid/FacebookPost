# ===================================================================
# CONFIGURATION FACEBOOKPOST - VERSION WINDOWS
# ===================================================================
# Fichier de configuration pour l'environnement Windows
# À copier vers .env dans C:\FacebookPost\backend\
# ===================================================================

# === CONFIGURATION BASE DE DONNÉES ===
MONGO_URL=mongodb://localhost:27017

# === CONFIGURATION FACEBOOK/META ===
FACEBOOK_APP_ID=5664227323683118
FACEBOOK_APP_SECRET=b359a1c87c920288385daf75aed873a3
JWT_SECRET=your-secret-key-change-in-production-windows
FACEBOOK_GRAPH_URL=https://graph.facebook.com/v18.0

# === CONFIGURATION NGROK ===
ENABLE_NGROK=true
NGROK_AUTH_TOKEN=
# Laissez vide pour utiliser la version gratuite de ngrok
# Si vous avez un compte payant, ajoutez votre token ici

# === WEBHOOK CONFIGURATION ===
EXTERNAL_WEBHOOK_ENABLED=true
FACEBOOK_VERIFY_TOKEN=mon_token_secret_webhook_windows

# === TOKENS D'ACCÈS BOUTIQUES ===
# Remplacez <TOKEN_*> par vos vrais tokens d'accès
FB_ACCESS_TOKEN_LOGICANTIQ=<TOKEN_LOGICANTIQ>
FB_ACCESS_TOKEN_LOGICAMPOUTDOOR=<TOKEN_LOGICAMPOUTDOOR>
FB_ACCESS_TOKEN_BERGER=<TOKEN_BERGER>
FB_ACCESS_TOKEN_GIZMO=<TOKEN_GIZMO>

# === IDS PAGES FACEBOOK ===
# Remplacez <PAGE_ID_*> par vos vrais IDs de pages
FB_PAGE_ID_LOGICANTIQ=<PAGE_ID_LOGICANTIQ>
FB_PAGE_ID_LOGICAMPOUTDOOR=<PAGE_ID_LOGICAMPOUTDOOR>
FB_PAGE_ID_BERGER=<PAGE_ID_BERGER>
FB_PAGE_ID_GIZMO=<PAGE_ID_GIZMO>

# === IDS COMPTES INSTAGRAM ===
# Remplacez <IG_ID_*> par vos vrais IDs Instagram Business
IG_USER_ID_LOGICANTIQ=<IG_ID_LOGICANTIQ>
IG_USER_ID_LOGICAMPOUTDOOR=<IG_ID_LOGICAMPOUTDOOR>
IG_USER_ID_BERGER=<IG_ID_BERGER>
IG_USER_ID_GIZMO=<IG_ID_GIZMO>

# === CONFIGURATION FTP (POUR HÉBERGEMENT IMAGES) ===
FTP_HOST=logicamp.org
FTP_PORT=21
FTP_USER=logi
FTP_PASSWORD=logi
FTP_DIRECTORY=/wordpress/uploads/
FTP_BASE_URL=https://logicamp.org/wordpress/uploads/

# === MODES DE FONCTIONNEMENT ===
# Mode test : true = simulation, false = publication réelle
PUBLICATION_TEST_MODE=true

# Mode dry-run : true = pas d'upload FTP, false = upload réel
DRY_RUN=false

# Force FTP : true = toujours utiliser FTP, false = auto
FORCE_FTP=false

# === CONFIGURATION WINDOWS SPÉCIFIQUE ===
# Chemins Windows (utilisés par le serveur)
WINDOWS_BACKEND_DIR=C:\FacebookPost\backend
WINDOWS_FRONTEND_DIR=C:\FacebookPost\frontend
WINDOWS_UPLOADS_DIR=C:\FacebookPost\backend\uploads
WINDOWS_LOGS_DIR=C:\FacebookPost\logs

# === CONFIGURATION SERVEUR ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FRONTEND_PORT=3000

# === SÉCURITÉ ===
# Changez ces valeurs en production !
SECRET_KEY=your-super-secret-key-for-windows-production
API_KEY_WEBHOOK=your-api-key-for-webhook-security

# === MONITORING ET LOGS ===
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_RETENTION_DAYS=30

# === DÉVELOPPEMENT ===
DEBUG=false
RELOAD=false